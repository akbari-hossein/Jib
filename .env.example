DATABASE_URL="postgresql://jib:jib@localhost:5432/jib"
AUTH_SECRET="replace-with-a-long-random-string"
# Google OAuth (optional). Leave empty to hide the Google button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to {request origin}/api/auth/google/callback
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Set to true to allow in-app Pro activation without a payment provider.
# In development this is already allowed.
# PRO_SELF_SERVE="true"
# Public site URL for canonical links, sitemap, and Open Graph.
# NEXT_PUBLIC_SITE_URL="https://example.com"
# Shared secret for GET /api/cron/notifications. Required in production (16+ chars).
# CRON_SECRET="replace-with-a-long-random-string"
# Web Push (optional). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Optional. mailto: or https URL used in VAPID claims.
# VAPID_SUBJECT="mailto:you@example.com"
