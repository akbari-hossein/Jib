DATABASE_URL="postgresql://jib:jib@localhost:5432/jib"
AUTH_SECRET="replace-with-a-long-random-string"
# Google OAuth (optional). Leave empty to hide the Google button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to {request origin}/api/auth/google/callback
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Set to true to allow in-app Pro activation without a payment provider.
# In development this is already allowed.
# PRO_SELF_SERVE="true"
# Shared secret for POST /api/internal/reference-rates (manual USD/gold rates).
# REFERENCE_RATE_INGEST_SECRET=""
# Shared secret for GET/POST /api/cron/reference-rates (live provider ingest).
# Falls back to REFERENCE_RATE_INGEST_SECRET if unset.
# CRON_SECRET=""
# Live market rates. Keys stay server-side — never prefix with NEXT_PUBLIC_.
# RATE_PROVIDER_NAME="navasan"
# RATE_PROVIDER_API_KEY=""
# RATE_PROVIDER_BASE_URL="https://api.navasan.tech"
# Polling interval is configured here, not assumed from a vendor's free tier.
# RATE_PROVIDER_POLL_INTERVAL_MINUTES="120"
# Optional symbol overlay (comma-separated asset:symbol). Empty symbol skips that asset.
# RATE_PROVIDER_ITEM_MAP="USD:usd_sell,EUR:eur,GOLD_COIN:sekkeh,GOLD_COIN_BAHAR:bahar,GOLD_GRAM:18ayar,SILVER:silver"
# Divide the provider quote to get toman. Use 10 if the API quotes rial.
# RATE_PROVIDER_TOMAN_SCALE="1"
# Public site URL for canonical links, sitemap, and Open Graph.
# NEXT_PUBLIC_SITE_URL="https://example.com"
