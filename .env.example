DATABASE_URL="postgresql://jib:jib@localhost:5432/jib"
AUTH_SECRET="replace-with-a-long-random-string"
# Google OAuth (optional). Leave empty to hide the Google button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to {request origin}/api/auth/google/callback
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Public site URL for canonical links, sitemap, and Open Graph.
# NEXT_PUBLIC_SITE_URL="https://example.com"
# Shared secret for GET /api/cron/notifications and GET/POST /api/cron/reference-rates.
# Required in production (16+ chars). Reference-rate ingest also accepts REFERENCE_RATE_INGEST_SECRET.
# CRON_SECRET="replace-with-a-long-random-string"
# Web Push (optional). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Optional. mailto: or https URL used in VAPID claims.
# VAPID_SUBJECT="mailto:you@example.com"
# First admin bootstrap. If no ADMIN users exist, this email is promoted on visiting /admin.
# ADMIN_BOOTSTRAP_EMAILS="you@example.com"
# Shared secret for POST /api/internal/reference-rates (manual USD/gold rates).
# REFERENCE_RATE_INGEST_SECRET=""
# Live market rates. Keys stay server-side — never prefix with NEXT_PUBLIC_.
# RATE_PROVIDER_NAME="navasan"
# RATE_PROVIDER_API_KEY=""
# RATE_PROVIDER_BASE_URL="https://api.navasan.tech"
# Polling interval is configured here, not assumed from a vendor's free tier.
# RATE_PROVIDER_POLL_INTERVAL_MINUTES="120"
# Optional symbol overlay (comma-separated asset:symbol). Empty symbol skips that asset.
# RATE_PROVIDER_ITEM_MAP="USD:usd_sell,EUR:eur,GOLD_COIN:sekkeh,GOLD_COIN_BAHAR:bahar,GOLD_GRAM:18ayar"
# Divide the provider quote to get toman. Use 10 if the API quotes rial.
# RATE_PROVIDER_TOMAN_SCALE="1"
# Mark a stored rate stale in the UI after this many hours (default 6).
# RATE_STALE_AFTER_HOURS="6"
# Log rate_ingest_stale_alert when no successful ingest for this many hours (default 24).
# RATE_ALERT_AFTER_HOURS="24"
