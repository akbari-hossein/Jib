generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AdminAuditAction {
  USER_DISABLED
  USER_REACTIVATED
  USER_ROLE_CHANGED
  USER_ONBOARDING_RESET
  USER_DELETED
}

enum AccountType {
  CASH
  BANK
  CARD
  SAVINGS
  OTHER
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  LOAN_GIVEN
  LOAN_RECEIVED
}

enum DebtType {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
}

enum CategoryGroup {
  ESSENTIAL
  LIVING
  LIFESTYLE
  FINANCIAL
}

enum CategoryKind {
  EXPENSE
  INCOME
  BOTH
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RuleMatchField {
  MERCHANT
  NOTE
}

enum RuleMatchType {
  EXACT
  CONTAINS
}

enum NotificationChannel {
  PUSH
  IN_APP
}

enum CalendarEventSource {
  MANUAL
  GOOGLE
}

enum FinancialTaskType {
  BILL_DUE
  BUDGET_CHECK
  RECURRING_REMINDER
  CUSTOM
}

enum FinancialTaskSource {
  RECURRING_TRANSACTION
  BUDGET
}

enum CheckInMood {
  GOOD
  NEUTRAL
  STRESSED
}

enum GoalType {
  CUSTOM
  EMERGENCY_FUND
}

enum SubscriptionStatus {
  TRIALING
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  REJECTED
}

enum ReceiptType {
  IMAGE
  TEXT
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String?
  googleId             String?    @unique
  name                 String?
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  incomeDayOfMonth     Int?
  expectedIncomeAmount BigInt?
  locale                 String    @default("fa-IR")
  currency               String    @default("TOMAN")
  onboardingCompletedAt  DateTime?
  lastActiveAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions             Session[]
  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  goals                Goal[]
  recurring            RecurringTransaction[]
  calendarEvents       CalendarEvent[]
  financialTasks       FinancialTask[]
  dailyCheckIns        DailyCheckIn[]
  rules                  TransactionRule[]
  notificationPref       NotificationPreference?
  notificationSettings   UserNotificationSetting[]
  notificationLogs       NotificationLog[]
  pushSubscriptions      PushSubscription[]
  adminAuditLogs         AdminAuditLog[]           @relation("AdminActor")
  contacts               Contact[]
  debtRecords            DebtRecord[]
  splitBills             SplitBill[]
  financialHealthSnapshots FinancialHealthSnapshot[]
  subscription             Subscription?
  paymentReceipts          PaymentReceipt[]

  @@index([role, status])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([onboardingCompletedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  type               AccountType
  balance            BigInt      @default(0)
  currency           String      @default("TOMAN")
  color              String?
  icon               String?
  isActive           Boolean     @default(true)
  includeInAvailable Boolean     @default(true)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  outgoingTransactions Transaction[]          @relation("AccountFrom")
  incomingTransfers    Transaction[]          @relation("AccountTo")
  recurring            RecurringTransaction[]
  goals                Goal[]
  debtRecords          DebtRecord[]
  settlementPayments   SettlementPayment[]
  splitBills           SplitBill[]

  @@index([userId, isActive])
}

model Category {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  group     CategoryGroup
  kind      CategoryKind  @default(EXPENSE)
  icon      String
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())

  transactions Transaction[]
  budgetItems  BudgetCategory[]
  recurring    RecurringTransaction[]
  rules        TransactionRule[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id                     String          @id @default(cuid())
  userId                 String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                   TransactionType
  amount                 BigInt
  accountId              String
  account                Account         @relation("AccountFrom", fields: [accountId], references: [id], onDelete: Restrict)
  toAccountId            String?
  toAccount              Account?        @relation("AccountTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  categoryId             String?
  category               Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occurredAt             DateTime
  merchant               String?
  note                   String?
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  debtRecord        DebtRecord?
  settlementPayment SettlementPayment?
  splitBill         SplitBill?

  @@index([userId, occurredAt])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([occurredAt])
  @@index([type, occurredAt])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jalaliYear   Int
  jalaliMonth  Int
  overallLimit BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories BudgetCategory[]

  @@unique([userId, jalaliYear, jalaliMonth])
  @@index([jalaliYear, jalaliMonth])
  @@index([createdAt])
}

model BudgetCategory {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  limit      BigInt

  @@unique([budgetId, categoryId])
}

model Goal {
  id                         String    @id @default(cuid())
  userId                     String
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  targetAmount               BigInt
  currentAmount              BigInt    @default(0)
  targetDate                 DateTime?
  accountId                  String?
  account                    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  icon                       String?
  isArchived                 Boolean   @default(false)
  type                       GoalType  @default(CUSTOM)
  targetMonths               Int?
  essentialCategoryIds       String[]  @default([])
  estimatedMonthlyEssential  BigInt?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([userId, isArchived])
  @@index([userId, type, isArchived])
  @@index([createdAt])
}

model RecurringTransaction {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       TransactionType
  amount     BigInt
  frequency  RecurringFrequency
  interval   Int                 @default(1)
  startDate  DateTime
  endDate    DateTime?
  nextRunAt  DateTime
  dayOfMonth Int?
  categoryId String
  category   Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  transactions Transaction[]

  @@index([userId, isActive, nextRunAt])
}

model CalendarEvent {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  startTime          DateTime
  endTime            DateTime?
  source             CalendarEventSource @default(MANUAL)
  externalId         String?
  externalProvider   String?
  /// User-entered Toman only. Never derived from title, category, or history.
  linkedCostEstimate BigInt?
  isDismissed        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, startTime])
  @@index([userId, externalId])
}

model FinancialTask {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        FinancialTaskType
  dueDate     DateTime             @db.Date
  isCompleted Boolean              @default(false)
  completedAt DateTime?
  sourceType  FinancialTaskSource?
  sourceId    String?
  createdAt   DateTime             @default(now())

  @@index([userId, dueDate, isCompleted])
  @@unique([userId, sourceType, sourceId, dueDate])
}

model DailyCheckIn {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  mood      CheckInMood
  createdAt DateTime     @default(now())

  @@unique([userId, date])
}

model TransactionRule {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchField RuleMatchField
  matchType  RuleMatchType
  matchValue String
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId  String?
  priority   Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@index([userId, isActive])
}

model NotificationPreference {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  muteAll            Boolean @default(false)
  preferredHour      Int     @default(20)
  quietHoursStart    Int?
  quietHoursEnd      Int?
  dailyAllowanceHour Int     @default(9)
  eveningHour        Int     @default(20)
  paceThresholdPct   Int     @default(25)
  budgetAlert        Boolean @default(true)
  weeklyReview       Boolean @default(true)
  goalMilestone      Boolean @default(true)
  recurringDue       Boolean @default(true)
  incomeExpected     Boolean @default(false)
}

model NotificationRule {
  id                String  @id @default(cuid())
  key               String  @unique
  title             String
  isActiveByDefault Boolean @default(true)
}

model UserNotificationSetting {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleKey         String
  enabled         Boolean             @default(true)
  channel         NotificationChannel @default(PUSH)
  quietHoursStart Int?
  quietHoursEnd   Int?

  @@unique([userId, ruleKey])
  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleKey   String
  payload   Json
  sentAt    DateTime @default(now())
  dedupeKey String
  readAt    DateTime?

  @@unique([userId, ruleKey, dedupeKey])
  @@index([userId, sentAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String?
  admin      User?            @relation("AdminActor", fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String
  action     AdminAuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  color     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debtRecords DebtRecord[]

  @@index([userId])
}

model DebtRecord {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact    @relation(fields: [contactId], references: [id], onDelete: Restrict)
  type             DebtType
  originalAmount   BigInt
  remainingAmount  BigInt
  reason           String?
  date             DateTime
  dueDate          DateTime?
  accountId        String?
  account          Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status           DebtStatus @default(OPEN)
  splitBillId      String?
  splitBill        SplitBill? @relation(fields: [splitBillId], references: [id], onDelete: SetNull)
  transactionId    String?    @unique
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  settlements SettlementPayment[]

  @@index([userId, status])
  @@index([contactId])
  @@index([status])
}

model SettlementPayment {
  id            String   @id @default(cuid())
  debtRecordId  String
  debtRecord    DebtRecord @relation(fields: [debtRecordId], references: [id], onDelete: Cascade)
  amount        BigInt
  date          DateTime @default(now())
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  note          String?
  transactionId String?  @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([debtRecordId])
}

model FinancialHealthSnapshot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalScore               Int
  savingsRateScore         Int
  budgetAdherenceScore     Int
  spendingConsistencyScore Int
  emergencyFundScore       Int
  debtBurdenScore          Int

  primaryDriver String?
  explanation   String?

  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@unique([userId, periodStart])
  @@index([userId, createdAt])
  @@index([userId, periodStart])
}

model SplitBill {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  totalAmount   BigInt
  date          DateTime
  paidByMe      Boolean  @default(true)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactionId String?  @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  debtRecords DebtRecord[]

  @@index([userId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  priceToman       Int                @default(59000)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  receipts PaymentReceipt[]

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
}

model PaymentReceipt {
  id                  String       @id @default(cuid())
  subscriptionId      String
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                ReceiptType
  imageUrl            String?
  rawText             String?
  claimedAmount       Int?
  claimedTransferDate DateTime?

  status              ReceiptStatus @default(PENDING)
  reviewedByAdminId   String?
  reviewedAt          DateTime?
  rejectionReasonCode String?
  /// Snapshot of Subscription.priceToman at approval time. Never recompute from the live price.
  amountToman         Int?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([subscriptionId])
  @@index([userId])
  @@index([status, reviewedAt])
  @@index([userId, status])
  // Partial unique index PaymentReceipt_one_pending_per_user lives in SQL (one PENDING row per user).
  // If user-list PaymentReceipt sums get slow at scale, add a covering index on
  // (userId, status, amountToman, reviewedAt). Not needed at MVP counts.
}
